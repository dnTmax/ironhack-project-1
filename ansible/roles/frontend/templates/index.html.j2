<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>Voting application</title>
</head>
<body style="font-family:sans-serif;text-align:center;margin-top:10%">
  <h1>Cats vs Dogs</h1>
  <p><a id="vote" href="#">Voter</a></p>
  <p><a id="result" href="#">Voir les resultats</a></p>
  <script>
    // Les liens utilisent l'adresse par laquelle la page a ete ouverte :
    // pas besoin de connaitre l'IP publique dans le template.
    var h = window.location.hostname;
    document.getElementById("vote").href = "http://" + h + ":8080";
    document.getElementById("result").href = "http://" + h + ":8081";
  </script>
</body>
</html>
